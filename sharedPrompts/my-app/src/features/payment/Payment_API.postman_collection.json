        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/payments/999999/status",
          "host": ["{{BASE_URL}}"],
          "path": ["payments", "999999", "status"]
        }
      },
      "response": []
    },
    {
      "name": "7. 인증 없이 결제 요청 (실패)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
