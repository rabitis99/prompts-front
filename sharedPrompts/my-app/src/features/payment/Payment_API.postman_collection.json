            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 29900,\n  \"currency\": \"KRW\",\n  \"payment_method\": \"TOSS\",\n  \"user_type\": \"PERSONAL\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/payments",
          "host": ["{{BASE_URL}}"],
          "path": ["payments"]
        }
      },
      "response": []
    },
    {
      "name": "8. 결제 요청 (카카오페이)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Payment method is KAKAO_PAY\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.payment_method).to.equal('KAKAO_PAY');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 29900,\n  \"currency\": \"KRW\",\n  \"payment_method\": \"KAKAO_PAY\",\n  \"user_type\": \"PERSONAL\",\n  \"metadata\": \"{\\\"product_name\\\":\\\"Premium Plan\\\"}\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/payments",
          "host": ["{{BASE_URL}}"],
          "path": ["payments"]
        }
      },
      "response": []
