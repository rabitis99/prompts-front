# 결제 시스템 Configuration

# 토스페이먼츠 (https://developers.tosspayments.com/)
VITE_TOSS_CLIENT_KEY=test_ck_your_toss_client_key_here

# PayPal (https://developer.paypal.com/)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# 카카오페이는 백엔드에서만 Admin Key 사용 (프론트엔드 환경변수 불필요)

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Firebase Configuration (for FCM push notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
